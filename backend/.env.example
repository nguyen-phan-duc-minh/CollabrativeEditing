# AI Service Configuration
# Uncomment and set your API keys for AI services

# Google Gemini API (Free tier available)
# Get your API key from: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI Compatible API (optional)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
# OPENAI_MODEL=gpt-3.5-turbo

# Or use other OpenAI-compatible services like:
# - Groq: https://console.groq.com/keys
# - Together: https://api.together.ai/
# - Local models with Ollama: http://localhost:11434/v1/chat/completions

# Note: If no API keys are set, the system will use fallback responses